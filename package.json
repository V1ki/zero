{
  "name": "zero-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "benchmarks/*"],
  "scripts": {
    "test": "bun test apps/server/ apps/supervisor/ apps/web/ packages/channel/ packages/compaction/ packages/core/ packages/memory/ packages/model/ packages/observe/ packages/scheduler/ packages/secrets/ packages/shared/ packages/supervisor/",
    "test:e2e": "bunx playwright test",
    "e2e:server": "bun run e2e/server.ts",
    "check": "bunx tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build:web": "cd apps/web && bun run build",
    "dev:web": "cd apps/web && bun run dev",
    "zero": "bun run apps/server/src/cli.ts",
    "x-search:probe": "bun run benchmarks/x-search-usage-probe/run.ts",
    "compaction:harness-eval": "bun run benchmarks/zero-runtime/compaction-harness-eval.ts",
    "compaction:tool-io-digest": "bun run benchmarks/zero-runtime/tool-io-digest-benchmark.ts",
    "logs:storage-audit": "bun run benchmarks/zero-runtime/log-storage-audit.ts",
    "task-closure:prompt-bench": "bun run benchmarks/zero-runtime/task-closure-prompt-benchmark.ts",
    "prompt:bench": "bun run benchmarks/zero-runtime/prompt-benchmark.ts",
    "bench": "bun run benchmarks/platform/src/cli.ts",
    "bench:test": "bun test benchmarks/platform/src/__tests__"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.58.2"
  }
}
